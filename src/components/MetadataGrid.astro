---
import type { Lang } from '../i18n/languages';
import { useTranslations } from '../i18n/utils';

interface Props {
  role: string;
  timeline: string;
  platform: string;
  company: string;
  lang: Lang;
}

const { role, timeline, platform, company, lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { label: t('caseStudy.role'), value: role },
  { label: t('caseStudy.timeline'), value: timeline },
  { label: t('caseStudy.platform'), value: platform },
  { label: t('caseStudy.company'), value: company },
];
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-y border-neutral-200">
  {items.map((item) => (
    <div>
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
        {item.label}
      </p>
      <p class="text-sm text-neutral-950">
        {item.value}
      </p>
    </div>
  ))}
</div>
