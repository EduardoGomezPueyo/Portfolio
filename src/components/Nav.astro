---
import {
  getLangFromUrl,
  useTranslations,
  getLocalizedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const caseStudiesPath = getLocalizedPath("/", lang);
const galleryPath = getLocalizedPath("/gallery", lang);
const aboutPath = getLocalizedPath("/about", lang);
---

<nav
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-neutral-50/80 border-b border-neutral-200/50"
>
  <div
    class="w-full px-6 grid grid-cols-[1fr_auto_1fr] gap-3 sm:gap-4 items-center h-16"
  >
    <!-- Left: Name -->
    <div class="justify-self-start">
      <a
        href={caseStudiesPath}
        class="text-sm font-semibold text-neutral-700 hover:text-neutral-950 transition-colors"
      >
        <span class="hidden sm:inline">Eduardo Gómez Pueyo</span>
        <span class="sm:hidden">EG</span>
      </a>
    </div>

    <!-- Center: Case Studies + Gallery + About -->
    <div
      class="flex items-center gap-3 sm:gap-6 text-sm font-semibold"
    >
      <a
        href={caseStudiesPath}
        class={`whitespace-nowrap transition-colors ${currentPath === caseStudiesPath ?"text-neutral-950 font-bold" : "text-neutral-600 hover:text-neutral-950"}`}
      >
        {t("nav.caseStudies")}
      </a>
      <a
        href={galleryPath}
        class={`transition-colors ${currentPath.replace(/\/$/, "") === galleryPath.replace(/\/$/, "") ? "text-neutral-950 font-bold" : "text-neutral-600 hover:text-neutral-950"}`}
      >
        {t("nav.gallery")}
      </a>
      <a
        href={aboutPath}
        class={`transition-colors ${currentPath.includes("/about") ? "text-neutral-950 font-bold" : "text-neutral-600 hover:text-neutral-950"}`}
      >
        {t("nav.about")}
      </a>
    </div>

    <!-- Right: Resume -->
    <div class="justify-self-end">
      <a
        href="/Eduardo-Gomez-Pueyo-CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-neutral-700 hover:text-neutral-950 transition-colors"
      >
        Resume
      </a>
    </div>
  </div>
</nav>
