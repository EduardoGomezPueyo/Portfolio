---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import MetadataGrid from "../components/MetadataGrid.astro";
import CaseStudySummary from "../components/CaseStudySummary.astro";
import NextProject from "../components/NextProject.astro";
import type { Lang } from "../i18n/languages";

interface Props {
  title: string;
  description: string;
  heroImage: ImageMetadata;
  role: string;
  timeline: string;
  platform: string;
  company: string;
  summary?: {
    problem: string;
    role: string;
    outcome: string;
  };
  lang: Lang;
  slug: string;
  nextProject?: {
    title: string;
    slug: string;
    thumbnail: ImageMetadata;
  };
}

const {
  title,
  description,
  heroImage,
  role,
  timeline,
  platform,
  company,
  summary,
  lang,
  slug,
  nextProject,
} = Astro.props;
---

<BaseLayout
  title={`${title} — Eduardo Gómez Pueyo`}
  description={description}
  lang={lang}
  image={heroImage.src}
>
  <!-- Hero -->
  <section class="pt-24 md:pt-32 pb-16 md:pb-24">
    <div class="max-w-content mx-auto px-6">
      <div class="mb-12">
        <p
          class="font-mono text-sm text-neutral-500 uppercase tracking-wider mb-4 animate-fade-in"
        >
          {role}
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-neutral-950 mb-6 animate-fade-in-up"
        >
          {title}
        </h1>
        <p
          class="text-lg text-neutral-700 leading-relaxed animate-fade-in-up"
          style="animation-delay: 100ms;"
        >
          {description}
        </p>
      </div>

      <!-- Summary -->
      {
        summary && (
          <div
            class="mb-12 animate-fade-in-up"
            style="animation-delay: 150ms;"
          >
            <CaseStudySummary
              problem={summary.problem}
              role={summary.role}
              outcome={summary.outcome}
              lang={lang}
            />
          </div>
        )
      }

      <!-- Hero image -->
      <div
        class="overflow-hidden rounded-lg bg-neutral-100 aspect-[16/9] animate-fade-in-up"
        style="animation-delay: 200ms;"
      >
        <Image
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover"
          widths={[640, 1104]}
          sizes="(min-width: 1152px) 1104px, 100vw"
          loading="eager"
          transition:name={`project-image-${slug}`}
        />
      </div>

      <!-- Metadata -->
      <div class="mt-12">
        <MetadataGrid
          role={role}
          timeline={timeline}
          platform={platform}
          company={company}
          lang={lang}
        />
      </div>
    </div>
  </section>

  <!-- MDX Content -->
  <section class="pb-24 md:pb-32">
    <div class="max-w-content mx-auto px-6">
      <div
        class="case-study-body prose prose-neutral prose-headings:font-display prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-16 prose-h2:mb-6 prose-p:leading-relaxed prose-a:text-neutral-900 prose-img:rounded-lg max-w-none"
      >
        <slot />
      </div>
    </div>
  </section>

  <!-- Next Project -->
  {
    nextProject && (
      <NextProject
        title={nextProject.title}
        slug={nextProject.slug}
        thumbnail={nextProject.thumbnail}
        lang={lang}
      />
    )
  }
</BaseLayout>
