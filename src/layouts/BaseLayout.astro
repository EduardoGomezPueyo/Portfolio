---
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../i18n/languages';
import SEOHead from '../components/SEOHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
}

const { title, description, lang, image } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <SEOHead title={title} description={description} lang={lang} image={image} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
    <script>
      function initBlurLoad() {
        // Handle images
        document.querySelectorAll<HTMLImageElement>('img:not([data-no-blur])').forEach((img) => {
          if (img.complete && img.naturalWidth > 0) {
            img.setAttribute('data-loaded', '');
          } else {
            img.addEventListener('load', () => img.setAttribute('data-loaded', ''), { once: true });
            img.addEventListener('error', () => img.setAttribute('data-loaded', ''), { once: true });
          }
        });

        // Handle videos
        document.querySelectorAll<HTMLVideoElement>('video:not([data-no-blur])').forEach((video) => {
          if (video.readyState >= 2) {
            video.setAttribute('data-loaded', '');
          } else {
            video.addEventListener('loadeddata', () => video.setAttribute('data-loaded', ''), { once: true });
            video.addEventListener('error', () => video.setAttribute('data-loaded', ''), { once: true });
          }
        });
      }

      document.addEventListener('astro:page-load', initBlurLoad);
    </script>
  </body>
</html>
